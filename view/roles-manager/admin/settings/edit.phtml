<?php

$plugins = $this->getHelperPluginManager();
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$assetUrl = $plugins->get('assetUrl');
$RolesManager = $this->RolesManager();

$this->htmlElement('body')->appendAttribute('class', 'settings edit');

$this->headLink()->appendStylesheet($assetUrl('css/settings.css', 'RolesManager'));
$this->headScript()->appendFile($assetUrl('js/settings.js', 'RolesManager'), 'text/javascript', ['defer' => 'defer']);

$maintenance = [];
if ($this->userIsAllowed('RolesManager\Controller\Admin\Import', 'import')){
    $maintenance[$translate('Import')] = $this->url('admin/roles-manager/default', ['controller' => 'import', 'action' => 'browse']);
}
if ($this->userIsAllowed('RolesManager\Controller\Admin\Settings', 'backups')){
    $maintenance[$translate('Backups')] = $this->url('admin/roles-manager/default', ['controller' => 'settings', 'action' => 'backups']);
}
if ($this->userIsAllowed('RolesManager\Controller\Admin\Settings', 'uprules')){
    $maintenance[$translate('Update rules')] = $this->url('admin/roles-manager/default', ['controller' => 'settings', 'action' => 'uprules']);
}
if ($RolesManager->isAppDevMode() && $this->userIsAllowed('RolesManager\Controller\Admin\Settings', 'updoctrine')){
    $maintenance[$translate('Update Doctrine')] = $this->url('admin/roles-manager/default', ['controller' => 'settings', 'action' => 'updoctrine']);
}
if ($RolesManager->isAppDevMode() && $this->userIsAllowed('RolesManager\Controller\Admin\Settings', 'uplocaletpl')){
    $maintenance[$translate('Update Locale template')] = $this->url('admin/roles-manager/default', ['controller' => 'settings', 'action' => 'uplocaletpl']);
}

$form->prepare();
?>
<?= $this->pageTitle($translate('Settings'), 1, $translate('Roles Manager')) ?>
<?= $this->form()->openTag($form) ?>

<div id="page-actions">
    <?php if (!empty($maintenance)): ?>
        <?php if (count($maintenance) > 1): ?>
    <a href="#" id="expand-menu" class="collapsed button expand-more" aria-label="<?= $translate('Maintenance') ?>" title="<?= $translate('Maintenance') ?>" aria-expanded="false" aria-target="#maintenance-menu"><?= $translate('Maintenance') ?></a>
    <ul id="maintenance-menu" class="collapsible-menu">
        <?php foreach ($maintenance as $title => $url): ?>
        <li>
            <a href="<?= $url ?>" class="link"><?= $title ?></a>
        </li>
        <?php endforeach; ?>
    </ul>
        <?php else: ?>
            <a href="<?= current($maintenance) ?>" class="button"><?= key($maintenance) ?></a>
        <?php endif; ?>
    <?php endif; ?>
    <?php if ($this->userIsAllowed('RolesManager\Controller\Admin\Browse', 'browse')): ?>
        <?= $hyperlink($translate('Roles'), $this->url('admin/roles-manager/default', []), ['class' => 'button']) ?>
    <?php endif; ?>
    <button type="submit"><?= $translate('Save') ?></button>
</div>

<?= $this->formCollection($form, false) ?>
<?= $this->form()->closeTag() ?>
